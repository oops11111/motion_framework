+++ b/src/FluentHub/Views/RootRebuildState.cs
@@ -0,0 +1,62 @@
+// F2 local pilot: one pending rebuild, no creation until confirmed old disposal.
+namespace FluentHub.Views;
+
+internal sealed class RootRebuildState
+{
+	private readonly Func<Action, bool> _enqueue;
+	private readonly Action<string> _trace;
+	private int _generation;
+	private bool _pending;
+	private bool _closed;
+	private bool _scheduling;
+
+	internal RootRebuildState(Func<Action, bool> enqueue, Action<string> trace)
+	{
+		_enqueue = enqueue;
+		_trace = trace;
+	}
+	internal int Begin()
+	{
+		if (_closed || _pending) { _trace("F2 rebuild rejected closed/pending"); return 0; }
+		_pending = true;
+		return ++_generation;
+	}
+	internal bool OldDisposed(int generation, Action create)
+	{
+		if (_closed || !_pending || generation != _generation) return false;
+		_scheduling = true;
+		bool accepted;
+		try
+		{
+			accepted = _enqueue(() =>
+			{
+				if (_scheduling) { Fail(generation, "inline queue callback"); return; }
+				if (_closed || !_pending || generation != _generation) return;
+				try { create(); }
+				catch (Exception ex) { Fail(generation, "creation threw " + ex.GetType().Name); }
+				finally { if (generation == _generation) _pending = false; }
+			});
+		}
+		catch (Exception ex)
+		{
+			Fail(generation, "enqueue threw " + ex.GetType().Name);
+			return false;
+		}
+		finally { _scheduling = false; }
+		if (!accepted) Fail(generation, "DispatcherQueue rejected creation");
+		return accepted && !_closed && generation == _generation;
+	}
+	internal void Fail(int generation, string reason)
+	{
+		if (generation != _generation) return;
+		_pending = false;
+		_generation++;
+		_trace("F2 STOP " + reason);
+	}
+	internal void Close()
+	{
+		_closed = true;
+		_pending = false;
+		_generation++;
+	}
+}
