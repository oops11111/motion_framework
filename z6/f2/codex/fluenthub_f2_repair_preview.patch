@@ -0,0 +1,39 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace FluentHub.Views;
+
+internal sealed class PilotEventCounts
+{
+	private readonly Dictionary<string, int> _names = new();
+	private readonly Dictionary<string, int> _states = new();
+	internal string Observe(int id, string? eventName, Func<IReadOnlyList<object?>?> payloadGetter)
+	{
+		string name = id == 103 || id == 3 ? "FrameTick" : id == 4 ? "PresentStats" : eventName ?? "Event" + id;
+		_names[name] = _names.GetValueOrDefault(name) + 1;
+		if (name is "FrameTick" or "FrameTickAccept" or "PresentStats") return "";
+		if (name == "AnimationLifecycle")
+		{
+			var payload = payloadGetter();
+			if (payload is { Count: > 4 })
+			{
+				string state = payload[4]?.ToString() ?? "";
+				_states[state] = _states.GetValueOrDefault(state) + 1;
+				return "state=" + state;
+			}
+		}
+		else if (name == "IdleTransition")
+		{
+			var payload = payloadGetter();
+			if (payload is { Count: > 2 }) return $"activeCount={payload[1]} pumpOn={payload[2]}";
+		}
+		return "";
+	}
+	internal string Summary()
+	{
+		string names = string.Join(", ", _names.OrderBy(k => k.Key, StringComparer.Ordinal).Select(k => $"{k.Key}={k.Value}"));
+		string states = string.Join(", ", _states.OrderBy(k => k.Key, StringComparer.Ordinal).Select(k => $"{k.Key}={k.Value}"));
+		return $"ETW_SUMMARY distinctNames={_names.Count} names[{names}] lifecycle[{states}]";
+	}
+}
