--- /dev/null
+++ b/src/FluentHub/Views/NavMotionPilot.cs
@@ -0,0 +1,608 @@
+// Z5-T5 PILOT-ONLY (local side fork %USERPROFILE%/pilot/FluentHub; never pushed, no fork, no upstream PR).
+// Consumes the prebuilt FluidMotion.L1.dll from Z5-T5-0 (see SHA256SUMS); FluentHub does not compile L1 sources.
+// No timing judgement anywhere (PresentStats is a placeholder, N/A). PERF-CI HOLD. Success != adopt.
+
+using System.Diagnostics.Tracing;
+using Microsoft.UI.Dispatching;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.UI.Xaml.Input;
+using Microsoft.UI.Xaml.Media;
+using Microsoft.UI.Xaml.Media.Imaging;
+using Windows.Graphics.Imaging;
+using Windows.Storage;
+using Windows.Storage.Streams;
+using System.Runtime.InteropServices.WindowsRuntime;
+using System.Threading.Tasks;
+using MotionSoftDemo;
+
+namespace FluentHub.Views
+{
+	/// <summary>
+	/// Left NavigationView menu items: Loaded, wait for first frame, then Play "demo.enter" (tokens).
+	/// F1C hover enqueue unchanged. F2: after first enter Play, DispatcherQueue.TryEnqueue RootView forceReload (Unloaded Dispose, then Loaded Create).
+	/// F5: consume the window-owned reduced-motion source on the UI thread.
+	/// </summary>
+	internal sealed class NavMotionPilot : IDisposable
+	{
+		private const string OffsetX = "offsetX";
+		private const string OpacityProperty = "opacity";
+		private const string EnterTransition = "demo.enter";
+		private const double HoverOffset = 8;
+
+		// demo_motion.json springs.snappy (320ms, damping 0.78).
+		private static readonly SpringParams Snappy = new(0.32, 0.78);
+
+		private readonly PilotLog _log;
+		private readonly PilotEtwListener _listener;
+		private readonly MotionSystem _system;
+		private readonly Dictionary<NavigationViewItem, ulong> _targets = [];
+		private readonly Dictionary<ulong, NavigationViewItem> _items = [];
+		private readonly Dictionary<ulong, TranslateTransform> _transforms = [];
+		private readonly Dictionary<ulong, AnimationHandle> _enter = [];
+		private readonly Dictionary<ulong, AnimationHandle> _hover = [];
+		private readonly PointerEventHandler _enteredHandler;
+		private readonly PointerEventHandler _leftHandler;
+		private readonly DispatcherQueue _dispatcher;
+		private readonly NavigationView _nav;
+		private bool _renderingHooked;
+		private bool _windowHooked;
+		private bool _disposed;
+		private int _lifetimeGeneration;
+		private bool _firstFrameSeen;
+		private bool _enterPlayed;
+		private int _enterShots;
+		private bool _enterShotBusy;
+		private int _sinkCount;
+		private bool _f1cEnqueued;
+		private bool _f1cHoverPlayed;
+		private int _f1cOverlap;
+		private double? _f1cLastOffsetX;
+		private double? _f1cLastOpacity;
+		private double? _f1cMidObserved;
+		private const ulong F1cTarget = 1;
+		private readonly ReducedMotionState _reducedMotion;
+		private bool _f5AppliedAnimationsEnabled;
+		private static int s_f2Cycle;
+		private static bool s_f2RebuildQueued;
+		private readonly int _f2Cycle;
+
+		public NavMotionPilot(NavigationView navigationView)
+		{
+			_f2Cycle = System.Threading.Interlocked.Increment(ref s_f2Cycle);
+			_log = new PilotLog();
+			_log.Line($"PILOT start (Z6-F2, RootView rebuild cycle={_f2Cycle}; Unloaded Dispose then Loaded Create; F6 enter wait unchanged)");
+			_listener = new PilotEtwListener(_log);
+
+			_system = MotionSystem.Create();
+			_system.FramePumpChanged += OnFramePumpChanged;
+			_system.ValueChanged += OnValueChanged;
+
+			string tokensPath = Path.Combine(AppContext.BaseDirectory, "demo_motion.json");
+			string? diag = new MotionTokens(_system).Load(File.ReadAllText(tokensPath));
+			_log.Line("MotionTokens.Load demo_motion.json: " + (diag ?? "ok"));
+
+			_dispatcher = navigationView.DispatcherQueue;
+			_nav = navigationView;
+
+			_reducedMotion = MainWindow.Instance.ReducedMotion.State;
+			_reducedMotion.Changed += OnReducedMotionChanged;
+			ApplyReducedMotion(_reducedMotion.AnimationsEnabled, "initial");
+			_log.Line($"F5 subscriber attached cycle={_f2Cycle}; initial applied before Play");
+			_enteredHandler = OnItemPointerEntered;
+			_leftHandler = OnItemPointerLeft;
+
+			ulong target = 1;
+			foreach (object menuItem in navigationView.MenuItems)
+			{
+				if (menuItem is not NavigationViewItem item)
+				{
+					continue;
+				}
+
+				var transform = new TranslateTransform();
+				item.RenderTransform = transform;
+				_targets[item] = target;
+				_items[target] = item;
+				_transforms[target] = transform;
+				item.AddHandler(UIElement.PointerEnteredEvent, _enteredHandler, true);
+				item.AddHandler(UIElement.PointerExitedEvent, _leftHandler, true);
+				item.AddHandler(UIElement.PointerCanceledEvent, _leftHandler, true);
+				item.AddHandler(UIElement.PointerCaptureLostEvent, _leftHandler, true);
+				target++;
+			}
+
+			MainWindow.Instance.Closed += OnWindowClosed;
+			_windowHooked = true;
+
+			foreach (var (id, _) in _items)
+			{
+				// Z6-F6: create enter handles now, but Play only after the first host frame callback.
+				AnimationHandle enter = _system.CreateAnimation(id, EnterTransition);
+				_enter[id] = enter;
+				_log.Line($"F6 enter created (Play deferred) target={id} anim={enter.Id}");
+			}
+
+			// Hook the host frame source immediately so the first CompositionTarget.Rendering can be observed before Play.
+			if (!_renderingHooked)
+			{
+				CompositionTarget.Rendering += OnRendering;
+				_renderingHooked = true;
+			}
+			_log.Line("F6 waiting for first CompositionTarget.Rendering before Play");
+			_log.Line("F1C will enqueue hover from sink mid-flight via DispatcherQueue; no fm_* in sink/render; pointer hover ignored");
+			_log.Flush();
+		}
+
+		private async Task CaptureEnterShotAsync(int n)
+		{
+			int generation = _lifetimeGeneration;
+			bool IsCurrent() => !_disposed && generation == _lifetimeGeneration;
+			if (!IsCurrent()) return;
+			try
+			{
+				var rtb = new RenderTargetBitmap();
+				await rtb.RenderAsync(_nav);
+				if (!IsCurrent()) return;
+				var pixels = await rtb.GetPixelsAsync();
+				if (!IsCurrent()) return;
+				StorageFolder folder;
+				try
+				{
+					folder = ApplicationData.Current.LocalFolder;
+				}
+				catch (Exception)
+				{
+					folder = await StorageFolder.GetFolderFromPathAsync(Path.GetTempPath());
+				}
+				if (!IsCurrent()) return;
+				StorageFile file = await folder.CreateFileAsync($"z6_f6_enter_{n:00}.png", CreationCollisionOption.ReplaceExisting);
+				if (!IsCurrent()) return;
+				using IRandomAccessStream stream = await file.OpenAsync(FileAccessMode.ReadWrite);
+				if (!IsCurrent()) return;
+				BitmapEncoder encoder = await BitmapEncoder.CreateAsync(BitmapEncoder.PngEncoderId, stream);
+				if (!IsCurrent()) return;
+				encoder.SetPixelData(
+					BitmapPixelFormat.Bgra8,
+					BitmapAlphaMode.Premultiplied,
+					(uint)rtb.PixelWidth,
+					(uint)rtb.PixelHeight,
+					96,
+					96,
+					pixels.ToArray());
+				if (!IsCurrent()) return;
+				await encoder.FlushAsync();
+				if (!IsCurrent()) return;
+				_log.Line($"F6 ENTER_SHOT n={n} {rtb.PixelWidth}x{rtb.PixelHeight} path={file.Path}");
+			}
+			catch (Exception ex)
+			{
+				if (!IsCurrent()) return;
+				_log.Line($"F6 ENTER_SHOT n={n} fail={ex.GetType().Name}: {ex.Message}");
+			}
+			finally
+			{
+				if (IsCurrent()) _enterShotBusy = false;
+			}
+		}
+
+		private void OnItemPointerEntered(object sender, PointerRoutedEventArgs e)
+		{
+			// F1C: do not rely on human hover; ignore pointer so the interrupt is program-state only.
+			if (!_disposed)
+			{
+				_log.Line("F1C ignore pointer-enter (program-state hover only)");
+			}
+		}
+
+		private void OnItemPointerLeft(object sender, PointerRoutedEventArgs e)
+		{
+			if (!_disposed)
+			{
+				_log.Line("F1C ignore pointer-leave (program-state hover only)");
+			}
+		}
+
+		private void PlayHoverAfterMidFlight()
+		{
+			// Runs on DispatcherQueue, not inside sink/render. Same hover path as T5 (empty anim + Play + Retarget offsetX=8, no from).
+			if (_disposed || _f1cHoverPlayed)
+			{
+				return;
+			}
+
+			if (!_hover.TryGetValue(F1cTarget, out AnimationHandle? hover))
+			{
+				hover = _system.CreateAnimation(F1cTarget, null);
+				hover.Play();
+				_hover[F1cTarget] = hover;
+			}
+
+			bool ok = hover.Retarget(OffsetX, HoverOffset, Snappy);
+			_f1cHoverPlayed = true;
+			_log.Line($"F1C PLAY hover after mid-flight enqueue (not in sink/render) target={F1cTarget} anim={hover.Id} retarget({OffsetX}={HoverOffset}) ok={ok} mid_observed={_f1cMidObserved}");
+			_log.Flush();
+		}
+
+		private void OnValueChanged(ulong target, string property, double value)
+		{
+			// Sink: never call back into the motion API from here (L1 contract Table 2). Observation + TryEnqueue only.
+			if (_disposed)
+			{
+				return;
+			}
+
+			_sinkCount++;
+			if (property == OffsetX && _transforms.TryGetValue(target, out TranslateTransform? transform))
+			{
+				transform.X = value;
+			}
+			else if (property == OpacityProperty && _items.TryGetValue(target, out NavigationViewItem? item))
+			{
+				item.Opacity = Math.Clamp(value, 0, 1);
+			}
+
+			if (target != F1cTarget)
+			{
+				return;
+			}
+
+			if (property == OffsetX)
+			{
+				_f1cLastOffsetX = value;
+			}
+			else if (property == OpacityProperty)
+			{
+				_f1cLastOpacity = value;
+			}
+
+			// Enter mid-flight on offsetX: token starts at -80 and ends at 0. Do not Play/Retarget here.
+			if (_enterPlayed && !_f1cEnqueued && property == OffsetX && value > -80.0 && value < 0.0)
+			{
+				_f1cEnqueued = true;
+				_f1cMidObserved = value;
+				_log.Line($"F1C SINK mid-flight target={target} property={property} value={value} (enqueue hover; no fm_* in this callback)");
+				bool queued = _dispatcher.TryEnqueue(PlayHoverAfterMidFlight);
+				_log.Line($"F1C SINK enqueue hover ok={queued}");
+				_log.Flush();
+			}
+
+			if (_f1cHoverPlayed && _f1cLastOffsetX.HasValue && _f1cLastOpacity.HasValue)
+			{
+				double ox = _f1cLastOffsetX.Value;
+				double op = _f1cLastOpacity.Value;
+				if (op > 0.0 && op < 1.0 && System.Math.Abs(ox - HoverOffset) > 1e-6)
+				{
+					_f1cOverlap++;
+					if (_f1cOverlap <= 12)
+					{
+						_log.Line($"F1C_OVERLAP n={_f1cOverlap} target={target} offsetX={ox} opacity={op}");
+					}
+				}
+			}
+		}
+
+		private void OnFramePumpChanged(bool on)
+		{
+			// Render callback: only bind/unbind the host frame source here.
+			if (on && !_renderingHooked && !_disposed)
+			{
+				CompositionTarget.Rendering += OnRendering;
+				_renderingHooked = true;
+			}
+			else if (!on && _renderingHooked)
+			{
+				CompositionTarget.Rendering -= OnRendering;
+				_renderingHooked = false;
+			}
+		}
+
+		private void OnRendering(object? sender, object e)
+		{
+			if (_disposed)
+			{
+				return;
+			}
+
+			if (!_firstFrameSeen)
+			{
+				_firstFrameSeen = true;
+				_log.Line("F6 FIRST_FRAME callback (CompositionTarget.Rendering) before Play");
+				bool queued = _dispatcher.TryEnqueue(PlayEnterAfterFirstFrame);
+				_log.Line($"F6 FIRST_FRAME enqueue Play ok={queued}");
+				_log.Flush();
+			}
+
+			if (_enterPlayed && _enterShots < 6 && !_enterShotBusy)
+			{
+				int n = _enterShots++;
+				_enterShotBusy = true;
+				_ = CaptureEnterShotAsync(n);
+			}
+
+			_system.OnFrame();
+		}
+
+		private void PlayEnterAfterFirstFrame()
+		{
+			if (_disposed || _enterPlayed)
+			{
+				return;
+			}
+
+			_enterPlayed = true;
+			foreach (var (id, enter) in _enter)
+			{
+				enter.Play();
+				_log.Line($"F6 PLAY after first frame target={id} anim={enter.Id}");
+			}
+			if (!s_f2RebuildQueued && _f2Cycle == 1)
+			{
+				s_f2RebuildQueued = true;
+				bool queued = _dispatcher.TryEnqueue(RequestF2Rebuild);
+				_log.Line($"F2 enqueue RootView rebuild ok={queued} (DispatcherQueue, not sink/render)");
+			}
+			_log.Flush();
+		}
+
+		private void RequestF2Rebuild()
+		{
+			if (_disposed) return;
+			// UI thread, not sink/render. forceReload replaces Content: old RootView Unloaded (Dispose) then new Loaded (Create).
+			_log.Line("F2 REBUILD begin: MainWindow.InitializeApplication(forceReload=true)");
+			_log.Flush();
+			MainWindow.Instance.InitializeApplication(null, forceReload: true);
+		}
+
+		private void OnReducedMotionChanged(bool animationsEnabled, string source)
+		{
+			bool queued = _dispatcher.TryEnqueue(() => ApplyReducedMotion(animationsEnabled, source));
+			_log.Line($"F5 subscriber enqueue source={source} ok={queued} cycle={_f2Cycle}");
+		}
+
+		private void ApplyReducedMotion(bool animationsEnabled, string source)
+		{
+			// UI thread only (DispatcherQueue). SetReducedMotion is thread-affine and may snap running animations to their end.
+			if (_disposed)
+			{
+				return;
+			}
+
+			bool reduced = !animationsEnabled;
+			_log.Line($"F5 SetReducedMotion({reduced}) source={source} animationsEnabled={animationsEnabled} previous={_f5AppliedAnimationsEnabled} thread={Environment.CurrentManagedThreadId}");
+			_system.SetReducedMotion(reduced);
+			_f5AppliedAnimationsEnabled = animationsEnabled;
+			_log.Line($"F5 SetReducedMotion({reduced}) applied; last_animationsEnabled={_f5AppliedAnimationsEnabled}");
+			_log.Flush();
+		}
+
+		private void OnWindowClosed(object sender, WindowEventArgs args)
+		{
+			_log.Line("MainWindow.Closed -> Dispose");
+			Dispose();
+		}
+
+		public void Dispose()
+		{
+			if (_disposed)
+			{
+				return;
+			}
+
+			_disposed = true;
+			_lifetimeGeneration++;
+			_log.Line($"F1C_FINAL offsetX={_f1cLastOffsetX} opacity={_f1cLastOpacity} overlapSinkNotes={_f1cOverlap} enqueued={_f1cEnqueued} hoverPlayed={_f1cHoverPlayed} mid_observed={_f1cMidObserved} expected_offsetX={HoverOffset} (later writer target)");
+			_log.Line($"F2 Dispose begin cycle={_f2Cycle}");
+			_log.Line("Dispose begin");
+
+			foreach (var (item, _) in _targets)
+			{
+				item.RemoveHandler(UIElement.PointerEnteredEvent, _enteredHandler);
+				item.RemoveHandler(UIElement.PointerExitedEvent, _leftHandler);
+				item.RemoveHandler(UIElement.PointerCanceledEvent, _leftHandler);
+				item.RemoveHandler(UIElement.PointerCaptureLostEvent, _leftHandler);
+			}
+
+			if (_windowHooked)
+			{
+				MainWindow.Instance.Closed -= OnWindowClosed;
+				_windowHooked = false;
+			}
+
+			// Every handle: Cancel, then Release; then Dispose the system.
+			foreach (AnimationHandle handle in _enter.Values.Concat(_hover.Values))
+			{
+				handle.Cancel();
+				handle.Release();
+			}
+
+			_reducedMotion.Changed -= OnReducedMotionChanged;
+			_log.Line($"F5 subscriber detached cycle={_f2Cycle}");
+			_system.Dispose();
+
+			if (_renderingHooked)
+			{
+				CompositionTarget.Rendering -= OnRendering;
+				_renderingHooked = false;
+			}
+
+			_log.Line($"Dispose end handles={_enter.Count + _hover.Count} (enter={_enter.Count}, hover={_hover.Count}) sinkCalls={_sinkCount} cycle={_f2Cycle}");
+			_log.Line($"F2 Dispose end cycle={_f2Cycle}");
+			_log.Line(_listener.Summary());
+			_listener.DisposeTracked();
+			_log.Flush();
+		}
+	}
+
+	/// <summary>Shared in-memory line buffer (survives RootView rebuild), written to LocalState on Flush.</summary>
+	internal sealed class PilotLog
+	{
+		private const int Capacity = 4096;
+		private static readonly object SharedGate = new();
+		private static readonly List<string> SharedLines = [];
+		private static int SharedSeq;
+		private static int SharedDropped;
+		private static string? SharedPath;
+
+		public PilotLog()
+		{
+			EnsurePath();
+		}
+
+		private static void EnsurePath()
+		{
+			if (SharedPath is not null)
+			{
+				return;
+			}
+
+			string folder;
+			try
+			{
+				folder = Windows.Storage.ApplicationData.Current.LocalFolder.Path;
+			}
+			catch (Exception)
+			{
+				folder = Path.GetTempPath();
+			}
+
+			SharedPath = Path.Combine(folder, "z6_f2_motion.log");
+		}
+
+		public void Line(string text) => Write(text);
+
+		public static void Write(string text)
+		{
+			EnsurePath();
+			lock (SharedGate)
+			{
+				SharedSeq++;
+				if (SharedLines.Count >= Capacity)
+				{
+					SharedDropped++;
+					return;
+				}
+
+				SharedLines.Add($"{SharedSeq:D5} {text}");
+			}
+		}
+
+		public void Flush()
+		{
+			EnsurePath();
+			lock (SharedGate)
+			{
+				try
+				{
+					var all = new List<string>(SharedLines) { $"# path={SharedPath} lines={SharedLines.Count} dropped={SharedDropped} capacity={Capacity}" };
+					File.WriteAllLines(SharedPath!, all);
+				}
+				catch (Exception)
+				{
+					// Pilot logging must never take the app down.
+				}
+			}
+		}
+	}
+
+	/// <summary>
+	/// Host-side EventListener for the frozen FluidMotion-Motion provider. OnEventSourceCreated can run inside the
+	/// base constructor (before this constructor body), so matching sources are cached and enabled afterwards.
+	/// FrameTick is counted only; its payload is not logged (no timing data).
+	/// </summary>
+	internal sealed class PilotEtwListener : EventListener
+	{
+		private const string ProviderName = "FluidMotion-Motion";
+		private readonly object _gate = new();
+		private readonly PilotEventCounts _counts = new();
+		private static int s_active;
+		private bool _listenerDisposed;
+		private List<EventSource>? _pending;
+		private PilotLog? _log;
+
+		public PilotEtwListener(PilotLog log)
+		{
+			List<EventSource>? pending;
+			lock (_gate)
+			{
+				_log = log;
+				_log.Line($"F2 listener created active={System.Threading.Interlocked.Increment(ref s_active)}");
+				pending = _pending;
+				_pending = null;
+			}
+
+			if (pending is not null)
+			{
+				foreach (EventSource source in pending)
+				{
+					EnableProvider(source);
+				}
+			}
+		}
+
+		protected override void OnEventSourceCreated(EventSource eventSource)
+		{
+			if (eventSource is null || eventSource.Name != ProviderName)
+			{
+				return;
+			}
+
+			// _gate can be null here when called from the base constructor before field initialisers of a derived
+			// class run in some runtimes; field initialisers run first in C#, but stay defensive.
+			object? gate = _gate;
+			if (gate is null)
+			{
+				return;
+			}
+
+			lock (gate)
+			{
+				if (_log is null)
+				{
+					(_pending ??= []).Add(eventSource);
+					return;
+				}
+			}
+
+			EnableProvider(eventSource);
+		}
+
+		private void EnableProvider(EventSource source)
+		{
+			EnableEvents(source, EventLevel.Verbose, EventKeywords.All);
+			_log?.Line($"ETW_LISTENER enabled provider={source.Name} guid={source.Guid} level=Verbose");
+		}
+
+		protected override void OnEventWritten(EventWrittenEventArgs eventData)
+		{
+			if (eventData.EventSource?.Name != ProviderName)
+			{
+				return;
+			}
+
+			lock (_gate)
+			{
+				if (_listenerDisposed) return;
+				string detail = _counts.Observe(eventData.EventId, eventData.EventName, () => eventData.Payload);
+				if (eventData.EventId is 3 or 103 or 4 || eventData.EventName is "FrameTick" or "FrameTickAccept" or "PresentStats") return;
+				_log?.Line($"ETW_EVENT name={eventData.EventName} id={eventData.EventId} {detail}");
+			}
+		}
+
+		public void DisposeTracked()
+		{
+			lock (_gate)
+			{
+				if (_listenerDisposed) return;
+				_listenerDisposed = true;
+			}
+			Dispose();
+			_log?.Line($"F2 listener disposed active={System.Threading.Interlocked.Decrement(ref s_active)}");
+		}
+
+		public string Summary()
+		{
+			lock (_gate) return _counts.Summary();
+		}
+	}
+}
