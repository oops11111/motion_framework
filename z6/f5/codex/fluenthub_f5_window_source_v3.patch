+namespace FluentHub.Views;
+
+// Host-only state. Every operation is called on the window's UI dispatcher.
+internal sealed class ReducedMotionState(bool animationsEnabled, bool fake) : IDisposable
+{
+    private bool _disposed;
+    public bool AnimationsEnabled { get; private set; } = animationsEnabled;
+    public event Action<bool, string>? Changed;
+
+    public void Reread(bool enabled, string source)
+    {
+        if (_disposed || fake || enabled == AnimationsEnabled) return;
+        AnimationsEnabled = enabled;
+        Changed?.Invoke(enabled, source);
+    }
+
+    public void ToggleFake()
+    {
+        if (_disposed || !fake) return;
+        AnimationsEnabled = !AnimationsEnabled;
+        Changed?.Invoke(AnimationsEnabled, "fake");
+    }
+
+    public void Dispose()
+    {
+        _disposed = true;
+        Changed = null;
+    }
+}
