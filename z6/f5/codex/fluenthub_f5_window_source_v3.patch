+using System.Runtime.Versioning;
+using Microsoft.UI.Dispatching;
+using Microsoft.UI.Xaml;
+using Windows.UI.ViewManagement;
+using WinUIEx.Messaging;
+
+namespace FluentHub.Views;
+
+// Owned once by MainWindow; RootView recreation only replaces subscribers.
+internal sealed class WindowReducedMotionSource : IDisposable
+{
+    private readonly Window _window;
+    private readonly DispatcherQueue _dispatcher;
+    private readonly UISettings _settings = new();
+    private readonly PilotLog _log = new();
+    private readonly DispatcherQueueTimer _debounce;
+    private readonly WindowMessageMonitor? _monitor;
+    private readonly FakeReducedMotionSource? _fakeSource;
+    private readonly bool _fake;
+    private bool _disposed;
+    private int _wmCount, _eventCount, _activatedCount, _fakeCount;
+
+    public ReducedMotionState State { get; }
+
+    public WindowReducedMotionSource(Window window)
+    {
+        _window = window;
+        _dispatcher = window.DispatcherQueue;
+        _fake = Environment.GetEnvironmentVariable("FM_PILOT_F5") == "1";
+        State = new ReducedMotionState(_settings.AnimationsEnabled, _fake);
+        State.Changed += OnStateChanged;
+        _debounce = _dispatcher.CreateTimer();
+        _debounce.Interval = TimeSpan.FromMilliseconds(100);
+        _debounce.IsRepeating = false;
+        _debounce.Tick += OnDebounce;
+
+        if (_fake)
+        {
+            _fakeSource = new FakeReducedMotionSource(action => _dispatcher.TryEnqueue(() => action()), State, Log);
+            Log("F5 fake source enabled event=Local\\FM_PILOT_F5_TOGGLE");
+            return;
+        }
+
+        nint hwnd = WinRT.Interop.WindowNative.GetWindowHandle(window);
+        try
+        {
+            if (hwnd == 0) throw new InvalidOperationException("Top-level HWND is zero");
+            _monitor = new WindowMessageMonitor(hwnd);
+            _monitor.WindowMessageReceived += OnMessage;
+            Log($"F5 hook installed hwnd=0x{hwnd:X} method=WindowMessageMonitor ok=True");
+        }
+        catch (Exception ex)
+        {
+            _monitor?.Dispose();
+            Log($"F5 hook installed hwnd=0x{hwnd:X} method=WindowMessageMonitor ok=False error={ex.GetType().Name}");
+            throw; // Do not silently run a partial real source after hook failure.
+        }
+        _window.Activated += OnActivated;
+        if (OperatingSystem.IsWindowsVersionAtLeast(10, 0, 19041)) Subscribe();
+    }
+
+    private void Log(string line)
+    {
+        _log.Line(line);
+        _log.Flush();
+    }
+
+    private void OnMessage(object? sender, WindowMessageEventArgs args)
+    {
+        if (_disposed || (uint)args.Message.MessageId != 0x001A) return;
+        _wmCount++;
+        // Keep lParam as an address: it is optional and is not safe to dereference for injected diagnostics.
+        Log($"F5 WM_SETTINGCHANGE wParam=0x{args.Message.WParam:X} lParam=0x{args.Message.LParam:X} thread={Environment.CurrentManagedThreadId}");
+        _debounce.Stop();
+        _debounce.Start();
+    }
+
+    private void OnDebounce(DispatcherQueueTimer sender, object args) => QueueReread("wm");
+
+    private void OnActivated(object sender, WindowActivatedEventArgs args)
+    {
+        if (args.WindowActivationState == WindowActivationState.Deactivated) return;
+        _activatedCount++;
+        QueueReread("activated");
+    }
+
+    [SupportedOSPlatform("windows10.0.19041.0")]
+    private void Subscribe() => _settings.AnimationsEnabledChanged += OnAnimationsChanged;
+
+    [SupportedOSPlatform("windows10.0.19041.0")]
+    private void Unsubscribe() => _settings.AnimationsEnabledChanged -= OnAnimationsChanged;
+
+    private void OnAnimationsChanged(UISettings sender, UISettingsAnimationsEnabledChangedEventArgs args)
+    {
+        // Reread on the UI queue, rather than capture a possibly stale background-thread value.
+        bool queued = _dispatcher.TryEnqueue(() =>
+        {
+            if (_disposed) return;
+            _eventCount++;
+            Reread("event");
+        });
+        if (!queued) Log("F5 event enqueue ok=False");
+    }
+
+    private void QueueReread(string source)
+    {
+        bool queued = _dispatcher.TryEnqueue(() => { if (!_disposed) Reread(source); });
+        if (!queued) Log($"F5 {source} enqueue ok=False");
+    }
+
+    private void Reread(string source)
+    {
+        bool enabled = _settings.AnimationsEnabled;
+        if (enabled == State.AnimationsEnabled)
+            Log($"F5 reread unchanged animationsEnabled={enabled} source={source}");
+        State.Reread(enabled, source);
+    }
+
+    private void OnStateChanged(bool enabled, string source)
+    {
+        if (source == "fake") _fakeCount++;
+        Log($"F5 source changed animationsEnabled={enabled} source={source} thread={Environment.CurrentManagedThreadId}");
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _debounce.Stop();
+        _debounce.Tick -= OnDebounce;
+        _fakeSource?.Dispose();
+        _window.Activated -= OnActivated;
+        if (!_fake && OperatingSystem.IsWindowsVersionAtLeast(10, 0, 19041)) Unsubscribe();
+        if (_monitor is not null)
+        {
+            _monitor.WindowMessageReceived -= OnMessage;
+            _monitor.Dispose();
+        }
+        State.Dispose();
+        Log($"F5 source disposed hookRemoved={_monitor is not null} wm={_wmCount} event={_eventCount} activated={_activatedCount} fake={_fakeCount}");
+    }
+}
