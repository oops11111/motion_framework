+using System.Threading;
+
+namespace FluentHub.Views;
+
+// Opt-in host diagnostics only. The wait thread never calls MotionSystem.
+internal sealed class FakeReducedMotionSource : IDisposable
+{
+    private readonly EventWaitHandle _toggle = new(false, EventResetMode.AutoReset, @"Local\FM_PILOT_F5_TOGGLE");
+    private readonly RegisteredWaitHandle _wait;
+    private int _disposed;
+
+    public FakeReducedMotionSource(Func<Action, bool> enqueue, ReducedMotionState state, Action<string> log)
+    {
+        _wait = ThreadPool.RegisterWaitForSingleObject(_toggle, (_, _) =>
+        {
+            if (Volatile.Read(ref _disposed) != 0) return;
+            bool queued = enqueue(() =>
+            {
+                if (Volatile.Read(ref _disposed) == 0) state.ToggleFake();
+            });
+            log($"F5 fake enqueue ok={queued}");
+        }, null, Timeout.Infinite, false);
+    }
+
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+        _wait.Unregister(null);
+        _toggle.Dispose();
+    }
+}
