<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MotionSoftDemo.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MotionSoftDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" PointerPressed="OnRootPointerPressed">
        <Border
            x:Name="AnimBox"
            Width="120"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="40,0,0,0"
            Background="#FF3B82F6"
            CornerRadius="12"
            Opacity="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BoxTranslate" X="0" Y="0" />
            </Border.RenderTransform>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                FontSize="14"
                Text="spring" />
        </Border>
        <TextBlock
            x:Name="StatusText"
            Margin="40,40,40,0"
            VerticalAlignment="Top"
            Text="MotionSoftDemo — fluidmotion.dll (C ABI)" />
        <ToggleSwitch
            x:Name="ModeToggle"
            Margin="40,80,40,0"
            VerticalAlignment="Top"
            Header="动画路径"
            OffContent="软件路径"
            OnContent="合成器路径"
            Toggled="OnModeToggled" />
        <Button
            x:Name="MeasureButton"
            Margin="240,104,40,0"
            VerticalAlignment="Top"
            Content="运行测量 (S1 + §4 验收)"
            Click="OnMeasureClick" />
    </Grid>
</Page>

